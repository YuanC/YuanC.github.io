{
  "name": "yuanc.github.io",
  "version": "2.0.0",
  "description": "Yuan Chen's personal website",
  "private": true,
  "scripts": {
    "build:css": "esbuild src/css/app.css --bundle --minify --target=chrome91,edge91,firefox90,safari15.4 --outfile=dist/css/app.css",
    "build:js": "esbuild src/js/app.js --bundle --minify --format=iife --target=chrome91,edge91,firefox90,safari15.4 --outfile=dist/js/app.js",
    "build": "npm run build:css && npm run build:js",
    "dev": "esbuild src/css/app.css src/js/app.js --bundle --outdir=dist --outbase=src --target=chrome91,edge91,firefox90,safari15.4 --servedir=.",
    "test": "echo \"No tests specified\" && exit 0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YuanC/YuanC.github.io.git"
  },
  "author": "Yuan Chen",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/YuanC/YuanC.github.io/issues"
  },
  "homepage": "https://jerryyuanchen.com",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "d3-force": "^3.0.0",
    "d3-selection": "^3.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.1"
  }
}
